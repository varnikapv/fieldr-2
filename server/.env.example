# Neon Postgres connection string for the FieldNote sync server.
#
# Where to get it: create a project at https://neon.tech, open the project
# dashboard, and copy the *pooled* connection string. It looks like:
#   postgresql://USER:PASSWORD@ep-xxxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
#
# Copy this file to server/.env and fill in the value. server/.env is
# gitignored — never commit the real credential.
DATABASE_URL=
